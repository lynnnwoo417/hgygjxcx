.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f4ff 50%, #f0f8ff 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.poster-wrap {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
  background: #fff;
}

.poster-img {
  display: block;
  width: 100%;
  height: 420rpx;
  background: #f0f0f0;
}

.poster-zoom-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.poster-fullscreen {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.poster-full-img {
  max-width: 100%;
  max-height: 70vh;
}

.poster-full-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-save-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
  color: #2d1b4e;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.poster-close-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
}

.row {
  margin-bottom: 24rpx;
}

.row .label {
  display: block;
  font-size: 24rpx;
  color: #8b7aa8;
  margin-bottom: 8rpx;
}

.row .value {
  font-size: 30rpx;
  color: #2d1b4e;
}

.row .detail-text {
  display: block;
  line-height: 1.5;
}

.type-tag {
  display: inline-block;
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.type-regression {
  background: rgba(199, 126, 181, 0.2);
  color: #b85a8e;
}

.type-concert {
  background: rgba(101, 149, 220, 0.2);
  color: #3d6bb3;
}

.type-fansign {
  background: rgba(230, 160, 80, 0.25);
  color: #c47820;
}

.type-activity {
  background: rgba(86, 200, 150, 0.22);
  color: #1d8b61;
}

.btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
  color: #2d1b4e;
  border: none;
  border-radius: 16rpx;
  font-weight: 600;
}

.btn.ghost {
  margin-top: 18rpx;
  background: rgba(139, 122, 168, 0.12);
  color: #6b5b95;
}

.cta-hint {
  display: block;
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8b7aa8;
}
