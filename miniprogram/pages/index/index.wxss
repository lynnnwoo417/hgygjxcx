.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f4ff 50%, #f0f8ff 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2d1b4e;
  letter-spacing: 2rpx;
}

.slogan {
  display: block;
  font-size: 26rpx;
  color: #8b7aa8;
  margin-top: 12rpx;
}

.search-wrap {
  margin: 0 0 24rpx;
}

.search-bar {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 122, 168, 0.08);
}

.search-input {
  height: 72rpx;
  font-size: 28rpx;
  color: #2d1b4e;
  padding-right: 64rpx;
}

.search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(139, 122, 168, 0.15);
  color: #6b5b95;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}

.search-panel {
  margin-top: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
}

.search-empty {
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

.search-results {
  max-height: 520rpx;
}

.search-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.search-item:last-child {
  border-bottom: none;
}

.search-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.search-artist {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d1b4e;
  flex: 1;
}

.search-date {
  font-size: 22rpx;
  color: #8b7aa8;
}

.search-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-detail {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

.filter-tabs {
  display: flex;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 122, 168, 0.08);
}

.filter-tabs .tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8b7aa8;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.filter-tabs .tab.active {
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
  color: #2d1b4e;
  font-weight: 600;
}

.calendar-wrap {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
  margin-bottom: 32rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6b5b95;
  font-weight: 300;
}

.month-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d1b4e;
}

.weekdays {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8b7aa8;
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

.day-cell.other-month .day-num {
  color: #bbb;
}

.day-cell.today .day-num {
  font-weight: 700;
  color: #6b5b95;
}

.day-cell.selected {
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
}

.day-cell.selected .day-num {
  color: #2d1b4e;
}

.dot {
  position: absolute;
  bottom: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c77eb5;
}

.detail-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.08);
}

.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d1b4e;
  margin-bottom: 20rpx;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-item {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border-left: 6rpx solid #c77eb5;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.record-btn {
  font-size: 22rpx;
  color: #8b7aa8;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(139, 122, 168, 0.12);
}

.record-btn.active {
  color: #8a5b00;
  background: rgba(255, 210, 80, 0.35);
}

.schedule-item.clickable {
  cursor: pointer;
}

.schedule-item .extra-row {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.schedule-item .extra {
  font-size: 24rpx;
  color: #6b5b95;
}

.schedule-item .detail-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b7aa8;
}


.schedule-item .artist {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2d1b4e;
}

.fav-star {
  font-size: 34rpx;
  color: #cfcfcf;
}

.fav-star.active {
  color: #f0b429;
}

.schedule-item .type-row {
  margin: 8rpx 0 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.type-regression {
  background: rgba(199, 126, 181, 0.2);
  color: #b85a8e;
}

.type-concert {
  background: rgba(101, 149, 220, 0.2);
  color: #3d6bb3;
}

.type-fansign {
  background: rgba(230, 160, 80, 0.25);
  color: #c47820;
}

.type-activity {
  background: rgba(86, 200, 150, 0.22);
  color: #1d8b61;
}

.schedule-item .detail {
  font-size: 26rpx;
  color: #666;
}

.empty-tip {
  padding: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
