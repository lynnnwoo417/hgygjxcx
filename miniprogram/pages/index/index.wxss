.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f4ff 50%, #f0f8ff 100%);
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* 收起状态下首屏不滚动：固定块不压缩，余量全部给日历 */
.header,
.overview-card,
.search-wrap,
.filter-tabs,
.detail-section {
  flex-shrink: 0;
}

.header {
  text-align: center;
  margin-bottom: 10rpx;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2d1b4e;
  letter-spacing: 2rpx;
}

.slogan {
  display: block;
  font-size: 24rpx;
  color: #8b7aa8;
  margin-top: 6rpx;
}

.overview-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #2d1b4e 0%, #6b4e8d 62%, #c77eb5 100%);
  box-shadow: 0 12rpx 32rpx rgba(45, 27, 78, 0.2);
}

.overview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-copy { flex: 1; min-width: 0; }
.overview-kicker,
.overview-title,
.overview-meta { display: block; }
.overview-kicker { font-size: 18rpx; letter-spacing: 3rpx; opacity: .72; }
.overview-title { margin-top: 4rpx; font-size: 29rpx; font-weight: 700; }
.overview-meta { margin-top: 4rpx; font-size: 19rpx; opacity: .72; }

.flag-trigger {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 64rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .14);
  border: 2rpx solid rgba(255, 255, 255, .28);
  box-sizing: border-box;
}

.flag-trigger.open {
  background: rgba(255, 255, 255, .26);
  border-color: #fff;
}

.flag-caret {
  font-size: 22rpx;
  line-height: 1;
  opacity: .85;
  transform: translateY(-2rpx);
}

.flag-trigger.open .flag-caret {
  transform: rotate(180deg) translateY(-2rpx);
}

.flag-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height .22s ease;
}

.flag-panel.open {
  max-height: 220rpx;
}

.flag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 16rpx;
}

.flag-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, .12);
  border: 2rpx solid rgba(255, 255, 255, .22);
  box-sizing: border-box;
}

.flag-btn.active {
  background: rgba(255, 255, 255, .28);
  border-color: #fff;
}

.flag-emoji { font-size: 30rpx; line-height: 1; }

.search-wrap {
  margin: 0 0 12rpx;
}

.search-bar {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 122, 168, 0.08);
}

.search-input {
  height: 60rpx;
  font-size: 27rpx;
  color: #2d1b4e;
  padding-right: 64rpx;
}

.search-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(139, 122, 168, 0.15);
  color: #6b5b95;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}

.search-panel {
  margin-top: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
}

.search-empty {
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

.search-results {
  max-height: 520rpx;
}

.search-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.search-item:last-child {
  border-bottom: none;
}

.search-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.search-artist {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d1b4e;
  flex: 1;
}

.search-date {
  font-size: 22rpx;
  color: #8b7aa8;
}

.search-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-detail {
  font-size: 24rpx;
  color: #666;
  flex: 1;
}

.filter-tabs {
  display: flex;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 122, 168, 0.08);
}

.filter-tabs .tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8b7aa8;
  padding: 10rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.filter-tabs .tab.active {
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
  color: #2d1b4e;
  font-weight: 600;
}

.upcoming-chevron {
  width: 40rpx;
  text-align: center;
  font-size: 40rpx;
  line-height: 1;
  color: #8b7aa8;
  font-weight: 300;
  transform: rotate(90deg);
}
.upcoming-chevron.open {
  transform: rotate(-90deg);
}

.calendar-wrap {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 18rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
  margin-bottom: 12rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
  padding: 0 8rpx;
}

.arrow {
  width: 60rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6b5b95;
  font-weight: 300;
}

.month-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d1b4e;
}

.calendar-hint {
  display: block;
  margin: 0 8rpx 8rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #8b7aa8;
  text-align: center;
}

.weekdays {
  display: flex;
  margin-bottom: 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: #8b7aa8;
}

.days-grid {
  flex: 1 1 auto;
  display: flex;
  flex-wrap: wrap;
  align-content: space-between;
}

.day-cell {
  width: 14.28%;
  min-height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.day-num {
  font-size: 27rpx;
  color: #333;
}

.day-cell.other-month .day-num {
  color: #bbb;
}

.day-cell.today .day-num {
  font-weight: 700;
  color: #6b5b95;
}

.day-cell.selected {
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
}

.day-cell.selected .day-num {
  color: #2d1b4e;
}

.dot {
  position: absolute;
  bottom: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c77eb5;
}

.detail-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.08);
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.detail-head-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d1b4e;
}

.detail-count {
  font-size: 21rpx;
  color: #8b7aa8;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 18rpx;
}

.schedule-item {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border-left: 6rpx solid #c77eb5;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.record-btn {
  font-size: 22rpx;
  color: #8b7aa8;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(139, 122, 168, 0.12);
}

.record-btn.active {
  color: #8a5b00;
  background: rgba(255, 210, 80, 0.35);
}

.schedule-item.clickable {
  cursor: pointer;
}

.schedule-item .extra-row {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.schedule-item .extra {
  font-size: 24rpx;
  color: #6b5b95;
}

.schedule-item .detail-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b7aa8;
}


.schedule-item .artist {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2d1b4e;
}

.fav-star {
  font-size: 34rpx;
  color: #cfcfcf;
}

.fav-star.active {
  color: #f0b429;
}

.schedule-item .type-row {
  margin: 8rpx 0 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.type-regression {
  background: rgba(199, 126, 181, 0.2);
  color: #b85a8e;
}

.type-concert {
  background: rgba(101, 149, 220, 0.2);
  color: #3d6bb3;
}

.type-fansign {
  background: rgba(230, 160, 80, 0.25);
  color: #c47820;
}

.type-activity {
  background: rgba(86, 200, 150, 0.22);
  color: #1d8b61;
}

.schedule-item .detail {
  font-size: 26rpx;
  color: #666;
}

.empty-tip {
  padding: 40rpx 24rpx 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
