.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f4ff 50%, #f0f8ff 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2d1b4e;
}

.desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8b7aa8;
  line-height: 1.6;
}

.list-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
}

.cell {
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cell + .cell {
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.cell-title {
  font-size: 28rpx;
  color: #2d1b4e;
  font-weight: 600;
  flex: 1;
}

.cell-sub {
  font-size: 22rpx;
  color: #8b7aa8;
}

.cell-arrow {
  font-size: 30rpx;
  color: #c0b6d6;
}

