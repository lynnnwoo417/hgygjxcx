<view class="page">
  <view class="card">
    <text class="title">团体订阅</text>
    <text class="desc">订阅后会在「我的-提醒」里看到最近回归的提示（本机本地存储）。</text>
  </view>

  <view class="form-card">
    <input
      class="input"
      placeholder="输入团体名，如 IVE / BTS / TWS"
      value="{{input}}"
      bindinput="onInput"
      confirm-type="done"
    />
    <button class="btn" bindtap="onAdd">添加订阅</button>
    <text class="hint">{{hint}}</text>
  </view>

  <view class="list-card" wx:if="{{subs.length > 0}}">
    <text class="list-title">已订阅</text>
    <view class="sub-item" wx:for="{{subs}}" wx:key="index" data-index="{{index}}">
      <text class="sub-name">{{item}}</text>
      <text class="sub-remove" data-index="{{index}}" bindtap="onRemove">移除</text>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>还没有订阅任何团体</text>
  </view>
</view>

