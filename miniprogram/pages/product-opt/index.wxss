.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f7 0%, #f8f4ff 50%, #f0f8ff 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.card,
.form-card,
.list-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 122, 168, 0.12);
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2d1b4e;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #8b7aa8;
  line-height: 1.6;
}

.input {
  height: 72rpx;
  font-size: 28rpx;
  color: #2d1b4e;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: rgba(139, 122, 168, 0.08);
}

.btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #e8d5f0 0%, #d4c4f0 100%);
  color: #2d1b4e;
  border-radius: 16rpx;
  font-weight: 600;
}

.hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b7aa8;
}

.list-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2d1b4e;
  margin-bottom: 12rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.sub-item:first-of-type {
  border-top: none;
}

.sub-name {
  font-size: 28rpx;
  color: #2d1b4e;
  font-weight: 600;
}

.sub-remove {
  font-size: 24rpx;
  color: #b42318;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

