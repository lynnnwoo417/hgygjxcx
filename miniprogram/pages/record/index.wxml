<view class="page">
  <view class="card">
    <view class="title-row">
      <text class="title">我的行程</text>
      <view class="add-btn" bindtap="onOpenCreate">＋ 手动添加</view>
    </view>
    <text class="desc">计划在韩国参加的活动会汇总在这里。收藏是感兴趣，加入行程是打算去。</text>
  </view>

  <view class="list" wx:if="{{items.length > 0}}">
    <view class="item" wx:for="{{items}}" wx:key="index" data-index="{{index}}">
      <view class="row" bindtap="onOpen">
        <text class="name">{{item.artist}}</text>
        <text class="date">{{item.dateKey}}</text>
      </view>
      <text class="sub">{{item.type}} · {{item.detail}}</text>
      <text class="note" wx:if="{{item.note}}">备注：{{item.note}}</text>
      <view class="actions">
        <text class="action" data-index="{{index}}" bindtap="onEdit">写备注</text>
        <text class="action danger" data-index="{{index}}" bindtap="onRemove">移出行程</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>暂无行程，可从首页把活动加入行程</text>
  </view>

  <view class="modal-mask" wx:if="{{showCreate}}" bindtap="onCloseCreate"></view>
  <view class="modal" wx:if="{{showCreate}}">
    <view class="modal-card">
      <view class="modal-title">手动添加行程</view>
      <input
        class="input"
        placeholder="标题/团体名"
        value="{{formArtist}}"
        data-field="formArtist"
        bindinput="onFormInput"
      />
      <input
        class="input"
        placeholder="事件描述（可选）"
        value="{{formDetail}}"
        data-field="formDetail"
        bindinput="onFormInput"
      />
      <view class="row">
        <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="picker">类型：{{typeOptions[typeIndex]}}</view>
        </picker>
        <picker mode="date" value="{{formDate}}" bindchange="onDateChange">
          <view class="picker">{{formDate || '选择日期'}}</view>
        </picker>
      </view>
      <textarea
        class="textarea"
        placeholder="行程备注（可选）"
        value="{{formNote}}"
        data-field="formNote"
        bindinput="onFormInput"
        maxlength="200"
      />
      <view class="modal-actions">
        <button class="btn ghost" bindtap="onCloseCreate">取消</button>
        <button class="btn" bindtap="onCreateRecord">加入行程</button>
      </view>
    </view>
  </view>
</view>

